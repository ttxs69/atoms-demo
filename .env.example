# 复制为 .env 并填入真实值。本文件进版本库，永远不要填真实 key。

# 沙箱服务（必填）：https://console.e2b.dev
E2B_API_KEY=

# LLM：任何 OpenAI-compatible 或 Anthropic 协议端点均可
LLM_PROTOCOL=openai            # openai | anthropic
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# 常见组合：
#   deepseek  openai      https://api.deepseek.com/v1
#   glm       anthropic   https://open.bigmodel.cn/api/coding/paas/v4
#   minimax   anthropic   https://api.minimaxi.com/anthropic

# forge-accounts（平台自己的 Supabase 项目，与生成应用的共享项目无关）
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile（https://dash.cloudflare.com 领取）
TURNSTILE_SECRET_KEY=

# 额度（点数；内部 token，外部点数）
DAILY_CAP=100
TOKENS_PER_POINT=10000
RESERVE_ESTIMATE_TOKENS=3000

# 管理面板单 token（openssl rand -hex 24）
ADMIN_TOKEN=

# forge-app-backend（共享 Supabase 项目——一次性 provision，人工步骤）
# 与平台项目（SUPABASE_*）不同：这是所有生成应用的数据项目
APPS_SUPABASE_URL=
APPS_SUPABASE_PUBLISHABLE_KEY=
APPS_SUPABASE_SECRET_KEY=
APPS_SUPABASE_DB_URL=

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
